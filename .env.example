ENVIRONMENT=development
DATABASE_URL=mysql+pymysql://lab_user:lab_password@localhost:3306/lab_equipment?charset=utf8mb4
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
OVERDUE_CHECK_INTERVAL_SECONDS=300

# Configure all three values to enable the OIDC ID-token verification endpoint.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_JWKS_URL=
